rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // World Cup Global metadata (read-only for authenticated users, server-only writes)
    match /wc_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /wc_teams/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /wc_players/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /wc_fixtures/{docId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /playerScores/{playerId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    match /wc_api_usage/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // League subcollections
    match /leagues/{leagueId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;

      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      match /squads/{uid} {
        allow read: if request.auth != null;
        allow write: if false; // server-only writes
      }

      match /lineups/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // Per-manager draft watchlist — PRIVATE to its owner. Written server-side
      // (admin SDK via the /draft/watchlist API), so client writes are closed;
      // reads are owner-only so no manager can see another's pick queue, even if
      // they bypass the API and hit Firestore directly.
      match /draft/watchlists/{ownerUid}/list {
        allow read: if request.auth != null && request.auth.uid == ownerUid;
        allow write: if false; // server-only writes
      }

      match /draft/{docId} {
        allow read: if request.auth != null;
        allow write: if false; // server-only writes

        match /picks/{pickId} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }

      match /trades/{tradeId} {
        allow read: if request.auth != null;
        allow write: if false; // server-only writes
      }

      match /waivers/{waiverId} {
        allow read: if request.auth != null;
        allow write: if false; // server-only writes
      }

      match /scores/{gw} {
        allow read: if request.auth != null;
        allow write: if false; // server-only writes
      }

      match /schedule/{gw} {
        allow read: if request.auth != null;
        allow write: if false; // server-only writes
      }

      match /standings/{docId} {
        allow read: if request.auth != null;
        allow write: if false; // server-only writes
      }

      match /transfer_windows/{docId} {
        allow read: if request.auth != null;
        allow write: if false; // server-only writes
      }

      match /transactions/{docId} {
        allow read: if request.auth != null;
        allow write: if false; // server-only writes
      }
    }
  }
}
